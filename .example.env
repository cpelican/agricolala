

# local dev
POSTGRES_PASSWORD=agraria
DATABASE_URL=postgresql://agraria:agraria@localhost:5435/agraria?schema=public
DIRECT_URL=postgresql://agraria:agraria@localhost:5435/agraria?schema=public

GOOGLE_CLIENT_ID=<client_id>
GOOGLE_CLIENT_SECRET=<secret>

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<secret>

# Access request emails (Resend). All optional: without them, emails are skipped and logged.
# Keep the API key and the notification address secret: never prefix them with NEXT_PUBLIC_.
RESEND_API_KEY=<resend_api_key>
# Where new access requests are sent (your own inbox).
ACCESS_REQUEST_NOTIFY_EMAIL=<your_email>
# Sender. "Agricolala <onboarding@resend.dev>" works without a domain, but only for emails
# to your Resend account's address; the "you're in" email to users needs a verified domain.
EMAIL_FROM=Agricolala <onboarding@resend.dev>
